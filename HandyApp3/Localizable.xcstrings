    "One payment lifts every limit. The free tier holds %lld things, and %lld events and transactions on each." : {
      "comment" : "Setup tab's free-tier plan summary body. Args: thing limit, per-thing record limit.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One payment lifts every limit. The free tier holds %1$lld things, and %2$lld events and transactions on each."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo pago elimina todos los límites. El nivel gratuito permite %1$lld artículos, y %2$lld eventos y transacciones en cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul paiement lève toutes les limites. La formule gratuite permet %1$lld biens, et %2$lld événements et transactions sur chacun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次性付费即可解除所有限制。免费版最多支持 %1$lld 个物品，每个物品最多 %2$lld 项事件和交易。"
          }
        }
      }
    },
    "Unlimited events and transactions on every thing, instead of ^[%lld record](inflect: true) between them." : {
      "comment" : "Paywall benefit line. Arg: the free tier's per-thing record limit.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
