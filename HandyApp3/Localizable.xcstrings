    "Write once, then pick who hears it. Each message opens in its own app so you can read it before it goes." : {
      "comment" : "Setup tab tools. Text.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escríbelo una vez y elige quién lo recibe. Cada mensaje se abre en su propia aplicación para que puedas revisarlo antes de enviarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez une fois, puis choisissez qui le reçoit. Chaque message s'ouvre dans sa propre application afin que vous puissiez le relire avant l'envoi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需撰写一次，再选择接收对象。每条消息都会在各自的应用中打开，方便您在发送前查看。"
          }
        }
      }
    },
