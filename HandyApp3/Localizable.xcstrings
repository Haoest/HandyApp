          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Événements et transactions illimités sur chaque bien, au lieu de ^[%lld enregistrement](inflect: true) partagés entre eux."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
